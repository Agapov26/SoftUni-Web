@model GrandStay.Models.Guest

@{
    ViewData["Title"] = "Delete Guest";
}

<div class="container py-4">
    <h1>Delete Guest</h1>
    <p class="text-muted">
        Review the guest information before deleting.
    </p>

    <div class="alert alert-warning">
        <strong>Warning!</strong>
        Are you sure you want to delete this guest?
        This action cannot be undone.
    </div>

    <div class="card shadow-sm" style="max-width: 700px;">
        <div class="card-header">
            <h5 class="mb-0">Guest Information</h5>
        </div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">First Name</dt>
                <dd class="col-sm-8">@Model.FirstName</dd>

                <dt class="col-sm-4">Last Name</dt>
                <dd class="col-sm-8">@Model.LastName</dd>

                <dt class="col-sm-4">Email Address</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Phone Number</dt>
                <dd class="col-sm-8">@Model.PhoneNumber</dd>
            </dl>
        </div>

        <div class="card-footer d-flex gap-2">
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>
            </form>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>
        </div>
    </div>
</div>