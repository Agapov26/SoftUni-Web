@model GrandStay.Models.Guest

@{
    ViewData["Title"] = "Guest Details";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Guest Details</h1>
        <p class="text-muted">
            View guest information and contact details.
        </p>
    </div>

    <div class="card shadow-sm" style="max-width: 700px;">
        <div class="card-body">
            <h4 class="card-title">
                @Model.FirstName @Model.LastName
            </h4>
            <hr />

            <dl class="row mb-0">
                <dt class="col-sm-4">First Name</dt>
                <dd class="col-sm-8">@Model.FirstName</dd>

                <dt class="col-sm-4">Last Name</dt>
                <dd class="col-sm-8">@Model.LastName</dd>

                <dt class="col-sm-4">Email Address</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Phone Number</dt>
                <dd class="col-sm-8">@Model.PhoneNumber</dd>

                <dt class="col-sm-4">Total Bookings</dt>
                <dd class="col-sm-8">
                    @(Model.Bookings?.Count ?? 0)
                </dd>
            </dl>
        </div>

        <div class="card-footer d-flex gap-2">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Edit Guest
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Guests
            </a>
        </div>
    </div>
</div>