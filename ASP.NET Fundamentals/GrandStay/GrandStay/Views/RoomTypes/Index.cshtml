@model IEnumerable<GrandStay.Models.RoomType>

@{
    ViewData["Title"] = "Room Types";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Room Types</h1>
            <p class="text-muted mb-0">
                Manage the accommodation categories at GrandStay.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Room Type
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No room types have been added yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Base Price</th>
                        <th>Max Occupancy</th>
                        <th>Rooms</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.Description)
                                    ? "No description"
                                    : item.Description)
                            </td>

                            <td>
                                @item.BasePrice.ToString("F2")
                            </td>

                            <td>@item.MaxOccupancy guests</td>

                            <td>
                                <span class="badge bg-secondary">
                                    @(item.Rooms?.Count ?? 0)
                                </span>
                            </td>

                            <td class="text-end">
                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-info">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>