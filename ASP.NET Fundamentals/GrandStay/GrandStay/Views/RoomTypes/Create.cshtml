@model GrandStay.Models.RoomType

@{
    ViewData["Title"] = "Create Room Type";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Create Room Type</h1>
        <p class="text-muted">Add a new accommodation category to GrandStay.</p>
    </div>

    <hr />

    <div class="row">
        <div class="col-md-6 col-lg-5">
            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">
                        Room Type Name
                    </label>
                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Example: Deluxe Suite" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Describe this room category..."></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BasePrice" class="form-label">
                        Base Price (BGN)
                    </label>
                    <input asp-for="BasePrice"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control"
                           placeholder="Example: 150.00" />
                    <span asp-validation-for="BasePrice"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaxOccupancy" class="form-label">
                        Maximum Occupancy
                    </label>
                    <input asp-for="MaxOccupancy"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="Example: 2" />
                    <span asp-validation-for="MaxOccupancy"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Create Room Type
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Back to List
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}