@model GrandStay.Models.RoomType

@{
    ViewData["Title"] = "Room Type Details";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Room Type Details</h1>
        <p class="text-muted">View accommodation category information.</p>
    </div>

    <div class="card shadow-sm" style="max-width: 700px;">
        <div class="card-body">
            <h4 class="card-title">@Model.Name</h4>
            <hr />

            <dl class="row mb-0">
                <dt class="col-sm-5">Name</dt>
                <dd class="col-sm-7">@Model.Name</dd>

                <dt class="col-sm-5">Description</dt>
                <dd class="col-sm-7">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description"
                        : Model.Description)
                </dd>

                <dt class="col-sm-5">Base Price</dt>
                <dd class="col-sm-7">
                    @Model.BasePrice.ToString("F2") BGN
                </dd>

                <dt class="col-sm-5">Maximum Occupancy</dt>
                <dd class="col-sm-7">
                    @Model.MaxOccupancy guests
                </dd>

                <dt class="col-sm-5">Assigned Rooms</dt>
                <dd class="col-sm-7">
                    @(Model.Rooms?.Count ?? 0)
                </dd>
            </dl>
        </div>

        <div class="card-footer d-flex gap-2">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Edit Room Type
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Room Types
            </a>
        </div>
    </div>
</div>