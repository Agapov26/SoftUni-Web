@model GrandStay.Models.Room

@{
    ViewData["Title"] = "Room Details";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Room Details</h1>
        <p class="text-muted">View information about this GrandStay room.</p>
    </div>

    <div class="card shadow-sm" style="max-width: 750px;">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 class="card-img-top"
                 alt="Room @Model.RoomNumber"
                 style="max-height: 350px; object-fit: cover;" />
        }

        <div class="card-body">
            <h4 class="card-title">Room @Model.RoomNumber</h4>
            <hr />

            <dl class="row mb-0">
                <dt class="col-sm-4">Room Number</dt>
                <dd class="col-sm-8">@Model.RoomNumber</dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@Model.Description</dd>

                <dt class="col-sm-4">Room Type</dt>
                <dd class="col-sm-8">
                    @(Model.RoomType?.Name ?? "Not assigned")
                </dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>
            </dl>
        </div>

        <div class="card-footer d-flex gap-2">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Edit Room
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Rooms
            </a>
        </div>
    </div>
</div>