@model GrandStay.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Delete Room</h1>
        <p class="text-muted">Review the room information before deleting it.</p>
    </div>

    <div class="alert alert-warning">
        <strong>Warning!</strong>
        Are you sure you want to delete this room? This action cannot be undone.
    </div>

    <div class="card shadow-sm" style="max-width: 750px;">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 class="card-img-top"
                 alt="Room @Model.RoomNumber"
                 style="max-height: 300px; object-fit: cover;" />
        }

        <div class="card-body">
            <h4 class="card-title">Room @Model.RoomNumber</h4>
            <hr />

            <dl class="row mb-0">
                <dt class="col-sm-4">Room Number</dt>
                <dd class="col-sm-8">@Model.RoomNumber</dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description"
                        : Model.Description)
                </dd>

                <dt class="col-sm-4">Image</dt>
                <dd class="col-sm-8">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <a href="@Model.ImageUrl"
                           target="_blank"
                           rel="noopener noreferrer">
                            View Image
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">No image</span>
                    }
                </dd>

                <dt class="col-sm-4">Room Type</dt>
                <dd class="col-sm-8">
                    @(Model.RoomType?.Name ?? "Not assigned")
                </dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    @(Model.IsActive ? "Active" : "Inactive")
                </dd>

                <dt class="col-sm-4">Room ID</dt>
                <dd class="col-sm-8">@Model.Id</dd>
            </dl>
        </div>

        <div class="card-footer d-flex flex-wrap gap-2">
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Confirm Delete
                </button>
            </form>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancel
            </a>
        </div>
    </div>
</div>