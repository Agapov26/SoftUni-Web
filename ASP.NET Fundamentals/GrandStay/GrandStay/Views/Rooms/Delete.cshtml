@model GrandStay.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<div class="container py-4">
    <h1>Delete Room</h1>
    <p class="text-muted">Review the room information before deleting it.</p>

    <div class="alert alert-warning">
        <strong>Warning!</strong> Are you sure you want to delete this room?
    </div>

    <div class="card shadow-sm" style="max-width: 650px;">
        <div class="card-header">
            <h5 class="mb-0">Room Information</h5>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Room Number</dt>
                <dd class="col-sm-8">@Model.RoomNumber</dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@Model.Description</dd>

                <dt class="col-sm-4">Image URL</dt>
                <dd class="col-sm-8">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <a href="@Model.ImageUrl" target="_blank">
                            View Image
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">No image</span>
                    }
                </dd>

                <dt class="col-sm-4">Room Type</dt>
                <dd class="col-sm-8">
                    @(Model.RoomType?.Name ?? "Not assigned")
                </dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    @(Model.IsActive ? "Active" : "Inactive")
                </dd>
            </dl>
        </div>

        <div class="card-footer d-flex gap-2">
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>
            </form>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancel
            </a>
        </div>
    </div>
</div>