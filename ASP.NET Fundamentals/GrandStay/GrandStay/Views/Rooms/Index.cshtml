@model IEnumerable<GrandStay.Models.Room>

@{
    ViewData["Title"] = "Rooms";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Hotel Rooms</h1>
            <p class="text-muted mb-0">Manage all rooms in GrandStay.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add New Room
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No rooms have been added yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Room Number</th>
                        <th>Description</th>
                        <th>Room Type</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @item.RoomNumber
                            </td>

                            <td>
                                @(item.Description.Length > 60
                                    ? item.Description.Substring(0, 60) + "..."
                                    : item.Description)
                            </td>

                            <td>
                                @(item.RoomType?.Name ?? "Not assigned")
                            </td>

                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1 flex-wrap">

                                    <a asp-controller="RoomAmenities"
                                       asp-action="Manage"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-stars"></i> Manage Amenities
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>