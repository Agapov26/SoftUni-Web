@model GrandStay.Models.Amenity

@{
    ViewData["Title"] = "Create Amenity";
}

<div class="container py-4">
    <div class="mb-4">
        <h1>Create Amenity</h1>
        <p class="text-muted">
            Add a new hotel amenity to GrandStay.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Amenity Name</label>
                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Example: Free Wi-Fi" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"
                              placeholder="Describe this amenity..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Create Amenity
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Back to List
                </a>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}